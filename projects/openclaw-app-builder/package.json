{
  "name": "openclaw-app-builder",
  "version": "0.1.0",
  "description": "让产品经理通过 OpenClaw 用自然语言快速构建 AI 应用",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "build": "tsc && npm run build:web",
    "build:web": "vite build",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "openclaw",
    "mcp",
    "ai",
    "app-builder",
    "no-code"
  ],
  "author": "Clawton",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "inquirer": "^9.2.12",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "tailwindcss": "^3.4.17",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^3.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.55.0",
    "postcss": "^8.5.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
